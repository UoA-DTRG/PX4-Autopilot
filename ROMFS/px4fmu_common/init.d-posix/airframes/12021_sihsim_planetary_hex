#!/bin/sh
#
# @name SIH DTRG planetaryHex
#
# @type Octorotor Coaxial
# @class Copter
#
# @desc The planetaryHex (12018_dtrg_planetary_hex) in SITL with SIH as the
# simulator. SIH builds the vehicle from the same CA_ROTOR* geometry as control
# allocation (SIH_VEHICLE_TYPE 6), including the larger centre rotors through
# their CA_ROTORn_CT. Used by the DTRG constant command flight tests (test/dtrg).
#

PLANETARY_HEX_NATIVE_GZ_SITL=1
. ${R}etc/init.d/airframes/12018_dtrg_planetary_hex

PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=planetary_hex}

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1

param set-default EKF2_GPS_DELAY 0

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_FUNC5 105
param set-default PWM_MAIN_FUNC6 106
param set-default PWM_MAIN_FUNC7 107
param set-default PWM_MAIN_FUNC8 108

# Mass and inertia of the Gazebo model (planetary_hex_base), assumed, not measured.
# Rotor thrusts as Gazebo at full speed: outer 1e-6 * 3000^2 = 9.0 N, centre upper
# 1.6e-5 * 950^2 = 14.4 N, lower 1.28e-5 * 950^2 = 11.6 N. SIH_T_MAX is the mean
# rotor (CA_ROTORn_CT mean 1.111), SIH scales each rotor by its CT. With the thrust
# curve equal to THR_MDL_FAC, thrust is linear in the allocated command, as in
# control allocation; the vehicle hovers at outer ~0.31, centre ~0.72 / 0.58.
param set SIH_VEHICLE_TYPE 6
param set-default SIH_MASS 2.892
param set-default SIH_IXX 0.0573
param set-default SIH_IYY 0.0573
param set-default SIH_IZZ 0.1066
param set-default SIH_T_MAX 10.0
param set-default SIH_THR_MDL_FAC 0.666667
param set-default SIH_T_TAU 0.05
param set-default SIH_KDV 0.7

# As 12019_gz_planetary_hex: the flown MPC_XY_VEL_P_ACC 11 of 12018 limit-cycles
# in simulation, PX4's default does not. Tuned in simulation, not in flight.
param set-default MPC_XY_VEL_P_ACC 1.8

# DTRG mapping for the keyboard/RC-override scripts, as in 12019_gz_planetary_hex
param set-default RC_MAP_HT_ROLL 9
param set-default RC_MAP_HT_PITCH 10

# DTRG constant command on channel 7 for the keyboard/RC-override scripts
# (Tools/dtrg/keyboard_teleop.py key u). Inert until the switch is on in flight.
param set-default DTRG_CC_EN 1
param set-default DTRG_CC_MOTORS 192
param set-default RC_MAP_CC_MODE 7
