menuconfig MODULES_EFFECTIVENESS_ESTIMATOR
	bool "effectiveness_estimator"
	default n
	---help---
		Enable support for effectiveness_estimator

menuconfig USER_EFFECTIVENESS_ESTIMATOR
	bool "effectiveness_estimator running as userspace module"
	default y
	depends on BOARD_PROTECTED && MODULES_EFFECTIVENESS_ESTIMATOR
	---help---
		Put effectiveness_estimator in userspace memory
